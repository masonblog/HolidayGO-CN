{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "holidaygo-cn",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "holiday.masonhu.cc",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
